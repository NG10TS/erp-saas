# App
PROJECT_NAME=ERP Conversacional
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Security - CAMBIAR EN PRODUCCIÓN!
SECRET_KEY=generar_clave_segura_64_chars_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - Usar variables de Railway
DATABASE_URL=${RAILWAY_POSTGRESQL_URL}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=${RAILWAY_REDIS_URL}
CELERY_BROKER_URL=${RAILWAY_REDIS_URL}/1
CELERY_RESULT_BACKEND=${RAILWAY_REDIS_URL}/2

# AWS S3
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=us-east-1
S3_BUCKET_NAME=erp-invoices-prod
S3_PUBLIC_URL=https://cdn.erp.com


# WhatsApp
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=${WHATSAPP_PHONE_NUMBER_ID}
WHATSAPP_BUSINESS_ACCOUNT_ID=${WHATSAPP_BUSINESS_ACCOUNT_ID}
WHATSAPP_ACCESS_TOKEN=${WHATSAPP_ACCESS_TOKEN}
WHATSAPP_VERIFY_TOKEN=${WHATSAPP_VERIFY_TOKEN}
WHATSAPP_WEBHOOK_VERIFY_TOKEN=${WHATSAPP_WEBHOOK_VERIFY_TOKEN}
WHATSAPP_APP_ID=${WHATSAPP_APP_ID}
WHATSAPP_APP_SECRET=${WHATSAPP_APP_SECRET}
# SRI Ecuador
SRI_TEST_ENDPOINT=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PROD_ENDPOINT=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_AUTHORIZATION_TEST=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
SRI_AUTHORIZATION_PROD=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# CORS
BACKEND_CORS_ORIGINS=["https://app.erp.com", "https://admin.erp.com"]

# Sentry
SENTRY_DSN=${SENTRY_DSN}