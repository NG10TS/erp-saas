# ============================================
# ERP CONVERSACIONAL ECUADOR - PRODUCTION ENV EXAMPLE
# ============================================
# COPIA ESTE ARCHIVO A .env EN PRODUCCIÓN
# LAS VARIABLES DEBEN SER INYECTADAS POR RAILWAY/RENDER

# App
PROJECT_NAME=ERP Conversacional
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Security - INYECTAR DESDE ENTORNO
SECRET_KEY=${SECRET_KEY}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - INYECTAR DESDE RAILWAY/RENDER
DATABASE_URL=${DATABASE_URL}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis - INYECTAR DESDE RAILWAY/RENDER
REDIS_URL=${REDIS_URL}
CELERY_BROKER_URL=${CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${CELERY_RESULT_BACKEND}

# AWS S3 - INYECTAR DESDE ENTORNO
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=us-east-1
S3_BUCKET_NAME=erp-invoices-prod
S3_PUBLIC_URL=https://cdn.erp.com

# WhatsApp - INYECTAR DESDE ENTORNO
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=${WHATSAPP_PHONE_NUMBER_ID}
WHATSAPP_BUSINESS_ACCOUNT_ID=${WHATSAPP_BUSINESS_ACCOUNT_ID}
WHATSAPP_ACCESS_TOKEN=${WHATSAPP_ACCESS_TOKEN}
WHATSAPP_VERIFY_TOKEN=${WHATSAPP_VERIFY_TOKEN}
WHATSAPP_WEBHOOK_VERIFY_TOKEN=${WHATSAPP_WEBHOOK_VERIFY_TOKEN}
WHATSAPP_APP_ID=${WHATSAPP_APP_ID}
WHATSAPP_APP_SECRET=${WHATSAPP_APP_SECRET}

# SRI Ecuador
SRI_TEST_ENDPOINT=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PROD_ENDPOINT=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_AUTHORIZATION_TEST=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
SRI_AUTHORIZATION_PROD=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# CORS - CAMBIAR POR TU DOMINIO
BACKEND_CORS_ORIGINS=["https://tu-dominio.com"]

# Sentry - INYECTAR DESDE ENTORNO
SENTRY_DSN=${SENTRY_DSN}

# Email - INYECTAR DESDE ENTORNO
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=${SMTP_FROM}
SMTP_FROM_NAME=ERP Conversacional

# URLs - CAMBIAR POR TUS DOMINIOS
FRONTEND_URL=https://tu-frontend.com
BACKEND_URL=https://tu-backend.com

# SRI adicional
DEFAULT_ESTABLISHMENT=001
DEFAULT_POINT_OF_EMISSION=001
