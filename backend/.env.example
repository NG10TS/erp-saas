# ============================================
# ERP CONVERSACIONAL ECUADOR - ENV EXAMPLE
# ============================================
# COPIA ESTE ARCHIVO A .env Y COMPLETA TUS VALORES
# NUNCA SUBAS .env A GITHUB

# App
PROJECT_NAME=ERP Conversacional
ENVIRONMENT=development
DEBUG=true

# Database (elige una)
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db
# DATABASE_URL=sqlite:///./erp.db

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# Security - GENERA UNA NUEVA CON: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=erp-invoices-dev
S3_PUBLIC_URL=http://localhost:9000

# WhatsApp Business API
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_ID=your_app_id
WHATSAPP_APP_SECRET=your_app_secret

# SRI Ecuador
SRI_TEST_ENDPOINT=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PROD_ENDPOINT=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_AUTHORIZATION_TEST=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
SRI_AUTHORIZATION_PROD=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
SRI_MAX_RETRIES=3
SRI_TIMEOUT_SECONDS=60
SRI_ENVIRONMENT=1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Sentry (opcional)
SENTRY_DSN=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=ERP Conversacional

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# SRI Configuración adicional
DEFAULT_ESTABLISHMENT=001
DEFAULT_POINT_OF_EMISSION=001
SRI_CERTIFICATE_PATH=
SRI_CERTIFICATE_PASSWORD=
