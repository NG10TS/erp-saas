# ============================================
# APP CONFIGURATION
# ============================================
PROJECT_NAME=ERP Conversacional
ENVIRONMENT=development
DEBUG=true

# ============================================
# DATABASE - Elige UNA sola opción
# ============================================

# Opción 1: PostgreSQL (producción recomendada)
DATABASE_URL=postgresql://erp:erp123@localhost:5432/erp_db

# Opción 2: MySQL/MariaDB (descomentar para usar)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/erp_db

# Opción 3: SQLite (desarrollo rápido - descomentar para usar)
# DATABASE_URL=sqlite:///./erp.db

# Opción 4: SQL Server (descomentar para usar)
# DATABASE_URL=mssql+pyodbc://user:password@localhost/erp_db?driver=ODBC+Driver+17+for+SQL+Server

# Pool configuration (ignorado en SQLite)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

