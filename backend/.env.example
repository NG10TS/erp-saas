# ============================================
# ERP CONVERSACIONAL ECUADOR - ENV EXAMPLE
# ============================================

# App
PROJECT_NAME=ERP Conversacional
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Security (GENERAR UNA NUEVA)
SECRET_KEY=your_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# WhatsApp (TUS VALORES)
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=ERP Conversacional

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# SRI Ecuador
SRI_ENVIRONMENT=1
SRI_TEST_ENDPOINT=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PROD_ENDPOINT=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
